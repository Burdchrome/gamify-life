NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key

# E2E credentials for the dedicated confirmed Supabase test user.
TEST_EMAIL=test-user@example.com
TEST_PASSWORD=replace-with-test-password

# Second dedicated test account whose rows prove cross-user RLS isolation.
# Never a real user's account: e2e setup/cleanup wipe every habit row.
DECOY_EMAIL=decoy-user@example.com
DECOY_PASSWORD=replace-with-decoy-password
